{
  "name": "spyfall-universe",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -n server,web \"pnpm --filter @spyfall/server dev\" \"pnpm --filter @spyfall/web dev\"",
    "build": "pnpm --filter @spyfall/web build",
    "start": "pnpm --filter @spyfall/server start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 202611150001_baseline"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "prettier": "^3.10.1",
    "prisma": "^6.7.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  }
}
